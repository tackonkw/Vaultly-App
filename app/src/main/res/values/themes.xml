<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vaultly" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Premium Colors -->
        <item name="colorPrimary">@color/midnight_blue</item>
        <item name="colorOnPrimary">@color/silver_blue</item>
        <item name="colorSecondary">@color/electric_cyan</item>

        <!-- Full Immersion Mode (Midnight) -->
        <item name="android:windowBackground">@color/midnight_blue</item>
        <item name="android:statusBarColor">@color/midnight_blue</item>
        <item name="android:navigationBarColor">@color/midnight_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>

        <!-- Remove any default transitions for a cleaner splash feel -->
        <item name="android:windowActivityTransitions">true</item>
    </style>
</resources>